<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="placecell_robot">
  <material name="ceramic"><color rgba="0.9 0.93 0.95 1"/></material>
  <material name="graphite"><color rgba="0.055 0.075 0.10 1"/></material>
  <material name="cyan"><color rgba="0.04 0.8 0.94 1"/></material>
  <material name="silver"><color rgba="0.42 0.50 0.56 1"/></material>
  <material name="rubber"><color rgba="0.025 0.035 0.045 1"/></material>
  <xacro:arg name="mesh_root" default="model://robot/meshes"/>
  <xacro:property name="shell_mesh" value="$(arg mesh_root)/rounded_box.dae"/>
  <xacro:macro name="shell" params="name xyz scale material rpy:='0 0 0'">
    <visual name="${name}"><origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><mesh filename="${shell_mesh}" scale="${scale}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>
  <xacro:macro name="inertia" params="mass xx yy zz">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${xx}" ixy="0" ixz="0" iyy="${yy}" iyz="0" izz="${zz}"/>
    </inertial>
  </xacro:macro>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.18"/>
  </joint>
  <link name="base_link">
    <xacro:inertia mass="8" xx="0.11" yy="0.16" zz="0.23"/>
    <xacro:shell name="base_shell" xyz="0 0 0" scale="0.48 0.34 0.16" material="graphite"/>
    <xacro:shell name="base_deck" xyz="0 0 0.064" scale="0.44 0.32 0.045" material="ceramic"/>
    <xacro:shell name="front_light" xyz="0.237 0 0.005" scale="0.008 0.24 0.022" material="cyan"/>
    <collision><geometry><box size="0.48 0.34 0.16"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <xacro:inertia mass="0.4" xx="0.0011" yy="0.002" zz="0.0011"/>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.1" length="0.04"/></geometry><material name="rubber"/></visual>
      <visual name="hub"><origin xyz="0 ${0.022 if y > 0 else -0.022} 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.065" length="0.006"/></geometry><material name="silver"/></visual>
      <visual name="hub_center"><origin xyz="0 ${0.026 if y > 0 else -0.026} 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.033" length="0.006"/></geometry><material name="cyan"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.1" length="0.04"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel"/><origin xyz="0 ${y} -0.08"/><axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <gazebo reference="${side}_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="0.20"/>
  <xacro:wheel side="right" y="-0.20"/>
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <xacro:inertia mass="0.1" xx="0.0001" yy="0.0001" zz="0.0001"/>
      <visual><geometry><sphere radius="0.035"/></geometry><material name="rubber"/></visual>
      <collision><geometry><sphere radius="0.035"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.145"/></joint>
    <gazebo reference="${name}"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.19"/>
  <xacro:caster name="rear_caster" x="-0.19"/>
  <!-- The upper body is fixed; this robot navigates but does not manipulate objects. -->
  <joint name="humanoid_joint" type="fixed">
    <parent link="base_link"/><child link="humanoid_body"/><origin xyz="0 0 0.60"/>
  </joint>
  <link name="humanoid_body">
    <xacro:inertia mass="2.0" xx="0.12" yy="0.12" zz="0.025"/>
    <!-- All upper-body geometry fits the existing 0.48 x 0.46 m footprint. -->
    <collision><origin xyz="-0.025 0 -0.025"/><geometry><box size="0.30 0.45 0.98"/></geometry></collision>
    <!-- A narrow central column leaves the laser plane clear beyond its 8 cm near range. -->
    <visual name="column"><origin xyz="0 0 -0.31"/><geometry><cylinder radius="0.033" length="0.42"/></geometry><material name="silver"/></visual>
    <xacro:shell name="waist" xyz="-0.035 0 -0.10" scale="0.18 0.24 0.12" material="graphite"/>
    <xacro:shell name="torso" xyz="-0.045 0 0.065" scale="0.20 0.29 0.29" material="ceramic"/>
    <xacro:shell name="chest_screen" xyz="0.06 0 0.06" scale="0.016 0.16 0.15" material="graphite"/>
    <xacro:shell name="chest_indicator" xyz="0.07 0 0.07" scale="0.006 0.10 0.012" material="cyan"/>
    <xacro:shell name="chest_badge" xyz="0.07 0 0.025" scale="0.006 0.045 0.009" material="silver"/>
    <visual name="neck"><origin xyz="0 0 0.25"/><geometry><cylinder radius="0.04" length="0.09"/></geometry><material name="graphite"/></visual>
    <xacro:shell name="head" xyz="0.01 0 0.365" scale="0.20 0.24 0.20" material="ceramic"/>
    <xacro:shell name="visor" xyz="0.108 0 0.365" scale="0.028 0.207 0.12" material="graphite"/>
    <xacro:shell name="left_eye" xyz="0.125 0.053 0.378" scale="0.009 0.045 0.018" material="cyan"/>
    <xacro:shell name="right_eye" xyz="0.125 -0.053 0.378" scale="0.009 0.045 0.018" material="cyan"/>
    <xacro:macro name="arm" params="side sign">
      <visual name="${side}_shoulder"><origin xyz="-0.045 ${sign*0.178} 0.15"/><geometry><sphere radius="0.047"/></geometry><material name="graphite"/></visual>
      <xacro:shell name="${side}_upper_arm" xyz="-0.055 ${sign*0.184} 0.05" scale="0.085 0.070 0.18" material="ceramic"/>
      <visual name="${side}_elbow"><origin xyz="-0.050 ${sign*0.184} -0.045"/><geometry><sphere radius="0.037"/></geometry><material name="graphite"/></visual>
      <xacro:shell name="${side}_forearm" xyz="-0.014 ${sign*0.184} -0.12" rpy="0 -0.45 0" scale="0.074 0.070 0.16" material="ceramic"/>
      <xacro:shell name="${side}_hand" xyz="0.028 ${sign*0.184} -0.20" scale="0.065 0.072 0.065" material="graphite"/>
      <xacro:shell name="${side}_wrist_band" xyz="0.013 ${sign*0.184} -0.175" rpy="0 -0.45 0" scale="0.077 0.073 0.018" material="cyan"/>
      <visual name="${side}_ear"><origin xyz="0.005 ${sign*0.125} 0.365" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.046" length="0.016"/></geometry><material name="cyan"/></visual>
    </xacro:macro>
    <xacro:arm side="left" sign="1"/>
    <xacro:arm side="right" sign="-1"/>
  </link>
  <link name="camera_link">
    <xacro:shell name="depth_camera_housing" xyz="-0.025 0 0" scale="0.045 0.12 0.04" material="graphite"/>
    <visual name="camera_mount"><origin xyz="-0.11 0 0"/><geometry><box size="0.22 0.025 0.025"/></geometry><material name="silver"/></visual>
    <xacro:shell name="depth_camera_lens" xyz="0 0.037 0" scale="0.006 0.017 0.017" material="cyan"/>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.22 0 0.35"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="laser_frame"/>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0 0 0.2"/></joint>
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/rgbd_camera</topic><always_on>true</always_on><update_rate>5</update_rate>
      <camera>
        <horizontal_fov>1.0471975512</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>8.0</far></clip>
        <depth_camera><clip><near>0.1</near><far>8.0</far></clip></depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>laser_frame</gz_frame_id>
      <topic>/scan</topic><always_on>true</always_on><update_rate>10</update_rate>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
        <range><min>0.08</min><max>12</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.40</wheel_separation><wheel_radius>0.1</wheel_radius>
      <topic>/model/placecell_robot/cmd_vel</topic>
      <odom_topic>/model/placecell_robot/odometry</odom_topic>
      <tf_topic>/model/placecell_robot/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.35</max_linear_velocity><min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity><min_angular_velocity>-0.8</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration><min_angular_acceleration>-1.0</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/placecell_robot/joint_state</topic>
      <joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
