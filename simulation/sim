#!/usr/bin/env bash
set -euo pipefail
sim_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
compose=(docker compose -f "$sim_dir/compose.yaml")
inside=(bash /opt/placecell-sim/entrypoint.sh)
command="${1:-help}"
if (($#)); then shift; fi
case "$command" in
  build) "${compose[@]}" build "$@" ;;
  start) "${compose[@]}" up -d "$@" ;;
  start-nav) SIM_NAVIGATION=true "${compose[@]}" up -d --force-recreate "$@" ;;
  stop) "${compose[@]}" down ;;
  logs) "${compose[@]}" logs --tail 100 -f ;;
  shell) "${compose[@]}" exec simulator "${inside[@]}" bash ;;
  missions)
    if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
      echo 'Set OPENROUTER_API_KEY before starting missions. Camera ingestion and missions make paid API calls.' >&2
      exit 1
    fi
    echo 'Starting the opt-in mission profile in the foreground. Ctrl+C stops PlaceCell; Gazebo stays running.'
    # A lock prevents two profile launchers from sharing a collection/command topic.
    # Keep the credential out of arguments and out of the container configuration.
    "${compose[@]}" exec -e OPENROUTER_API_KEY simulator "${inside[@]}" \
      flock --no-fork -n -E 73 /home/simulator/placecell-missions.lock \
      python3 -m placecell.ros2.node --ros-args \
      --params-file /opt/placecell-sim/config/placecell.yaml \
      --params-file /opt/placecell-sim/config/missions.yaml "$@"
    ;;
  teleop)
    "${compose[@]}" exec simulator "${inside[@]}" ros2 run teleop_twist_keyboard teleop_twist_keyboard \
      --ros-args -p speed:=0.2 -p turn:=0.5
    ;;
  check)
    "${compose[@]}" exec -T simulator "${inside[@]}" python3 /opt/placecell-sim/scripts/smoke_test.py "$@" --output /home/simulator/smoke
    mkdir -p "$sim_dir/artifacts"
    "${compose[@]}" cp simulator:/home/simulator/smoke/. "$sim_dir/artifacts/"
    ;;
  check-operator|check-cancel|check-sensors|check-retention|check-recovery|check-recovery-gazebo|check-backup|check-overload)
    run_name="${command}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    mkdir -p "$sim_dir/artifacts/$run_name"
    # This standalone check needs neither a running office nor provider credentials.
    # Keep DDS and all model access inside an isolated network namespace.
    script=operator_test.py
    if [[ "$command" == check-cancel ]]; then script=cancellation_test.py; fi
    if [[ "$command" == check-sensors ]]; then script=sensor_test.py; fi
    if [[ "$command" == check-retention ]]; then script=retention_test.py; fi
    if [[ "$command" == check-backup ]]; then script=backup_test.py; fi
    if [[ "$command" == check-overload ]]; then script=overload_test.py; fi
    if [[ "$command" == check-recovery ]]; then script=recovery_test.py; fi
    if [[ "$command" == check-recovery-gazebo ]]; then script=run_recovery.py; fi
    test_output=/out
    if [[ "$command" == check-retention ]]; then test_output=/out/retention; fi
    if [[ "$command" == check-backup ]]; then test_output=/out/backup; fi
    if [[ "$command" == check-overload ]]; then test_output=/out/overload; fi
    if [[ "$command" == check-recovery* ]]; then test_output=/out/recovery; fi
    # Hosted CI runners have 4 CPUs, and docker rejects a limit above the host's count.
    cpus=$(( $(nproc) < 8 ? $(nproc) : 8 ))
    docker run --rm --network none --cpus "$cpus" --memory 16g --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -v "$sim_dir/artifacts/$run_name:/out" placecell-sim:jazzy \
      timeout 480 python3 "/opt/placecell-sim/scripts/$script" --output "$test_output" "$@"
    ;;
  check-nav|check-pipeline|check-missions|check-live-mission|record-commands)
    run_name="${command}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    extra=()
    environment=()
    script=pipeline_test.py
    if [[ "$command" == check-nav ]]; then
      extra+=(--navigation-only)
    elif [[ "$command" == check-missions ]]; then
      script=checkpoint_control.py
    elif [[ "$command" == record-commands ]]; then
      script=command_demo.py
    else
      if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
        echo 'Set OPENROUTER_API_KEY in your shell before the live test. No local model is downloaded.' >&2
        exit 1
      fi
      environment+=(-e OPENROUTER_API_KEY)
      if [[ "$command" == check-live-mission ]]; then script=checkpoint_live.py; fi
    fi
    result=0
    "${compose[@]}" exec -T "${environment[@]}" simulator "${inside[@]}" python3 \
      "/opt/placecell-sim/scripts/$script" --output "/home/simulator/$run_name" "${extra[@]}" "$@" || result=$?
    mkdir -p "$sim_dir/artifacts/$run_name"
    "${compose[@]}" cp "simulator:/home/simulator/$run_name/." "$sim_dir/artifacts/$run_name/"
    echo "Test artifacts: $sim_dir/artifacts/$run_name"
    exit "$result"
    ;;
  e2e)
    live=false
    for option in "$@"; do
      case "$option" in
        --live) live=true ;;
        *) echo "Unknown e2e option: $option. Usage: simulation/sim e2e [--live]" >&2; exit 2 ;;
      esac
    done
    if [[ "$live" == true && -z "${OPENROUTER_API_KEY:-}" ]]; then
      echo 'e2e --live needs OPENROUTER_API_KEY in your shell; nothing was built or started.' >&2
      echo 'The live checks make paid API calls. Run simulation/sim e2e without --live for the keyless checks.' >&2
      exit 1
    fi
    # A keyless run never forwards a credential, even one set in this shell.
    if [[ "$live" == false ]]; then unset OPENROUTER_API_KEY; fi
    self="$sim_dir/sim"
    repo_dir="$(dirname -- "$sim_dir")"
    # Each Gazebo check gets a fresh world; check-missions needs the default office with Nav2.
    plan=(build check-operator check-cancel check-sensors check-retention check-overload start check
      start-nav check-nav 'start-nav for check-missions' check-missions)
    if [[ "$live" == true ]]; then
      plan+=('start-nav for check-pipeline' check-pipeline 'start-nav for check-live-mission' check-live-mission)
    fi
    started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    run_dir="$sim_dir/artifacts/e2e-$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$run_dir"
    names=() results=() durations=() paths=()
    current='' current_started=0 current_dir='' interrupted=false

    result_of() {
      local i
      for i in "${!names[@]}"; do
        if [[ "${names[$i]}" == "$1" ]]; then echo "${results[$i]}"; return; fi
      done
      echo skipped
    }

    record() {  # record <name> <result> <seconds> <directory or empty>
      names+=("$1") results+=("$2") durations+=("$3") paths+=("${4:+${4#"$repo_dir"/}}")
    }

    step() {  # step <name> <prerequisite step or -> <command...>
      local name="$1" needs="$2" result=passed entry
      shift 2
      if [[ "$needs" != - && "$(result_of "$needs")" != passed ]]; then
        echo "== skipped $name: $needs did not pass"
        record "$name" skipped 0 ''
        return
      fi
      current="$name" current_started=$SECONDS
      current_dir="$run_dir/$(printf '%02d' $((${#names[@]} + 1)))-${name// /-}"
      mkdir -p "$current_dir"
      touch "$run_dir/.step-start"
      echo "== $name"
      if ! "$@" 2>&1 | tee "$current_dir/output.log"; then result=failed; fi
      # Checks write to their own artifacts/<command>-* directory; keep it with this run.
      while IFS= read -r -d '' entry; do mv -- "$entry" "$current_dir/"; done < <(
        find "$sim_dir/artifacts" -mindepth 1 -maxdepth 1 ! -path "$run_dir" -newer "$run_dir/.step-start" -print0)
      if [[ "$needs" != - || ("$result" == failed && "$name" == start*) ]]; then
        "${compose[@]}" logs --no-color > "$current_dir/simulator.log" 2>&1 || true
      fi
      record "$name" "$result" $((SECONDS - current_started)) "$current_dir"
      current=''
      echo "== $result $name ($((SECONDS - current_started)) s)"
    }

    start_navigation() {  # Fresh AMCL/Nav2 world, ready once both lifecycle managers are active.
      local attempt deadline logs
      for attempt in 1 2; do
        "$self" start-nav || return
        deadline=$((SECONDS + 240))
        while ((SECONDS < deadline)); do
          logs="$("${compose[@]}" logs --no-color simulator 2>&1 || true)"
          if grep -q 'lifecycle managers activated' <<<"$logs"; then
            echo "Nav2 active after attempt $attempt"
            return 0
          fi
          if [[ -z "$("${compose[@]}" ps --quiet --status running simulator 2>/dev/null)" ]] ||
            grep -q 'process has died.*activate_navigation' <<<"$logs"; then
            break
          fi
          sleep 2
        done
        echo "Nav2 did not become active (attempt $attempt of 2)"
      done
      return 1
    }

    finish() {
      local code=$? i failed=false stopped=true finished_at
      trap '' INT TERM
      if [[ -n "$current" ]]; then record "$current" failed $((SECONDS - current_started)) "$current_dir"; fi
      for ((i = ${#names[@]}; i < ${#plan[@]}; i++)); do record "${plan[$i]}" skipped 0 ''; done
      echo '== stopping the simulator'
      if ! "$self" stop > "$run_dir/stop.log" 2>&1; then
        stopped=false
        echo "simulation/sim stop failed; see $run_dir/stop.log" >&2
      fi
      rm -f -- "$run_dir/.step-start"
      for i in "${!names[@]}"; do
        if [[ "${results[$i]}" == failed ]]; then failed=true; fi
      done
      if [[ "$interrupted" == true || "$code" != 0 ]]; then failed=true; fi
      finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      {
        printf '{\n  "started_at": "%s",\n  "finished_at": "%s",\n' "$started_at" "$finished_at"
        printf '  "live": %s,\n  "interrupted": %s,\n  "simulator_stopped": %s,\n' "$live" "$interrupted" "$stopped"
        printf '  "passed": %s,\n  "steps": [\n' "$([[ "$failed" == false ]] && echo true || echo false)"
        for i in "${!names[@]}"; do
          printf '    {"step": "%s", "status": "%s", "duration_s": %s, "artifacts": "%s"}%s\n' "${names[$i]}" \
            "${results[$i]}" "${durations[$i]}" "${paths[$i]}" "$([[ $i -lt $((${#names[@]} - 1)) ]] && echo ,)"
        done
        printf '  ]\n}\n'
      } > "$run_dir/summary.json"
      {
        printf '# Simulation end-to-end run\n\n'
        printf '%s mode, %s to %s. Result: **%s**.\n\n' "$([[ "$live" == true ]] && echo Live || echo Keyless)" \
          "$started_at" "$finished_at" "$([[ "$failed" == false ]] && echo passed || echo failed)"
        printf '| Step | Status | Duration (s) | Artifacts |\n| --- | --- | ---: | --- |\n'
        for i in "${!names[@]}"; do
          printf '| %s | %s | %s | %s |\n' "${names[$i]}" "${results[$i]}" "${durations[$i]}" \
            "${paths[$i]:+\`${paths[$i]}\`}"
        done
        if [[ "$interrupted" == true ]]; then printf '\nInterrupted before completion.\n'; fi
        if [[ "$stopped" == false ]]; then printf '\n`simulation/sim stop` failed; see `stop.log`.\n'; fi
      } > "$run_dir/summary.md"
      cat "$run_dir/summary.md"
      echo "Summary: $run_dir/summary.json"
      if [[ "$interrupted" == true ]]; then exit 130; fi
      if [[ "$failed" == true ]]; then exit 1; fi
      exit 0
    }
    trap finish EXIT
    trap 'interrupted=true; exit 130' INT TERM

    step build - "$self" build
    # Nothing else can run on a stale or missing image.
    if [[ "$(result_of build)" != passed ]]; then exit 1; fi
    step check-operator - "$self" check-operator
    step check-cancel - "$self" check-cancel
    step check-sensors - "$self" check-sensors
    step check-retention - "$self" check-retention
    step check-overload - "$self" check-overload --samples 100
    step start - "$self" start --force-recreate
    step check start "$self" check
    step start-nav - start_navigation
    step check-nav start-nav "$self" check-nav
    step 'start-nav for check-missions' - start_navigation
    step check-missions 'start-nav for check-missions' "$self" check-missions
    if [[ "$live" == true ]]; then
      step 'start-nav for check-pipeline' - start_navigation
      step check-pipeline 'start-nav for check-pipeline' "$self" check-pipeline
      step 'start-nav for check-live-mission' - start_navigation
      step check-live-mission 'start-nav for check-live-mission' "$self" check-live-mission
    fi
    exit 0
    ;;
  gui)
    if [[ -z "${DISPLAY:-}" ]] || ! command -v xauth >/dev/null; then
      echo 'GUI mode needs a local X11/XWayland session and xauth. Use start for headless mode.' >&2
      exit 1
    fi
    auth_dir="$(mktemp -d)"
    export SIM_XAUTHORITY="$auth_dir/xauthority"
    trap '"${compose[@]}" down; rm -f -- "$SIM_XAUTHORITY"; rmdir -- "$auth_dir"' EXIT
    touch "$SIM_XAUTHORITY"
    xauth nlist "$DISPLAY" | sed 's/^..../ffff/' | xauth -f "$SIM_XAUTHORITY" nmerge -
    if [[ ! -s "$SIM_XAUTHORITY" ]]; then
      echo 'No authorization cookie found for this display.' >&2
      exit 1
    fi
    chmod 644 "$SIM_XAUTHORITY"
    "${compose[@]}" -f "$sim_dir/compose.gui.yaml" up --force-recreate
    ;;
  *)
    echo 'Usage: simulation/sim {build|start|start-nav|gui|teleop|missions|check|check-operator|check-cancel|check-sensors|check-retention|check-recovery|check-recovery-gazebo|check-backup|check-overload|check-nav|check-pipeline|check-missions|check-live-mission|record-commands|e2e|logs|shell|stop}'
    echo 'check moves the simulated robot; check --sensors-only only inspects sensor data.'
    echo 'e2e runs every keyless check in order and always stops the simulator; e2e --live adds the paid live checks.'
    echo 'missions requires start-nav and a funded API key; see docs/reference-deployment.md.'
    ;;
esac
